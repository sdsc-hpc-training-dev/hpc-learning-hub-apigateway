    {
      "name": "Materials",
      "item": [
        {
          "name": "Materials List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/materials",
              "host": ["{{baseURL}}"],
              "path": ["materials"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const body = pm.response.json();",
                  "pm.test('returns a paginated material page', () => { pm.expect(body).to.have.all.keys('items', 'page', 'pageSize', 'total', 'totalPages'); pm.expect(body.items).to.be.an('array'); pm.expect(body.page).to.be.a('number').and.to.be.at.least(1); pm.expect(body.pageSize).to.be.a('number').and.to.be.at.least(1); pm.expect(body.total).to.be.a('number').and.to.be.at.least(0); pm.expect(body.totalPages).to.be.a('number').and.to.be.at.least(0); });",
                  "pm.test('material items use the documented shape', () => body.items.forEach((item) => pm.expect(item).to.include.all.keys('id', 'title', 'description', 'eventEditions', 'topics', 'tools', 'systems', 'instructors', 'resources')));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Materials Query (pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/materials?page=1&pageSize=5",
              "host": ["{{baseURL}}"],
              "path": ["materials"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200 OK for valid query parameters', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('honors the requested pagination', () => { pm.expect(body.page).to.eql(1); pm.expect(body.pageSize).to.eql(5); pm.expect(body.items).to.be.an('array').with.lengthOf.at.most(5); });",
                  "pm.test('pagination metadata is internally consistent', () => { pm.expect(body.total).to.be.at.least(body.items.length); pm.expect(body.totalPages).to.eql(Math.ceil(body.total / body.pageSize)); });"
                ]
              }
            }
          ],
          "response": []
        },
