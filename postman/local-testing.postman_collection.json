        {
          "name": "Material Query 400 (invalid page)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/materials?page=0",
              "host": ["{{baseURL}}"],
              "path": ["materials"],
              "query": [{ "key": "page", "value": "0" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 400 Bad Request for an invalid page', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('returns the standard API error contract', () => { pm.expect(body).to.include.all.keys('statusCode', 'error', 'timestamp', 'message', 'path'); pm.expect(body.statusCode).to.eql(400); pm.expect(body.error).to.eql('Bad Request'); pm.expect(body.path).to.include('/materials'); });",
                  "pm.test('identifies the invalid page parameter', () => pm.expect(JSON.stringify(body.message)).to.include('page'));"
                ]
              }
            }
          ],
          "response": []
        },
